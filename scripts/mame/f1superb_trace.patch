+// MS32 MiSTer core: native access counters for the regions the core has to
+// provide, enabled by MS32_TRACE=<file>. Costs one compare when unset.
+// Not for upstream.
+struct ms32_trace_t
+{
+	struct one { u64 count = 0; u32 lo = ~u32(0); u32 hi = 0; std::set<u32> blocks; };
+
+	ms32_trace_t()
+	{
+		char const *const p = getenv("MS32_TRACE");
+		if (p) { path = p; enabled = true; }
+	}
+	~ms32_trace_t() { if (enabled) dump(); }
+
+	void note(int region, u32 offset);
+	void dump();
+
+	bool enabled = false;
+	std::string path;
+	one reg[6];
+};
