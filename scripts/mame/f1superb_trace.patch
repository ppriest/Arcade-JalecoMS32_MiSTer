+// MS32 MiSTer core: the reference trace the RTL transcription in
+// rtl/cpu/jalfpu/jalfpu.sv is checked against. JALFPU_TRACE=<dir> writes, per
+// device: <tag>_prg.bin (program RAM at the first routine start, 1,024 u32),
+// <tag>_run.txt (one line per routine start), <tag>_exec.txt (one line per
+// instruction: ppc, opcode, then the state after it). JALFPU_TRACE_MAX caps
+// the instruction count, default 2,000,000. Not for upstream.
+void jaleco_fpu_device::ms32_trace_open()
+{
+	char const *const dir = getenv("JALFPU_TRACE");
+	if (!dir)
+		return;
+	m_trace_base = std::string(dir) + "/" + std::string(tag()).substr(1);
+	m_trace_exec = fopen((m_trace_base + "_exec.txt").c_str(), "w");
+	m_trace_run = fopen((m_trace_base + "_run.txt").c_str(), "w");
+	char const *const cap = getenv("JALFPU_TRACE_MAX");
+	m_trace_left = cap ? strtoull(cap, nullptr, 0) : 2000000;
+}
+
+void jaleco_fpu_device::ms32_trace_host(char kind, u32 offset, u32 data)
+{
+	if (m_trace_exec && m_trace_left)
+		fprintf(m_trace_exec, "H %c %04X %08X%s", kind, offset, data, "\n");
+}
+
+void jaleco_fpu_device::ms32_trace_state(FILE *f) const
+{
+	for (int i = 0; i < 16; i++)
+		fprintf(f, " %04X", m_s[i]);
+	fprintf(f, " %04X %04X %X %04X %d%s", m_c6, m_c7, m_flags, m_sign, m_sp, "\n");
+}
+
+void jaleco_fpu_device::ms32_trace_start()
+{
+	if (!m_trace_run)
+		return;
+	if (!m_trace_dumped)
+	{
+		m_trace_dumped = true;
+		FILE *g = fopen((m_trace_base + "_prg.bin").c_str(), "wb");
+		if (g)
+		{
+			fwrite(&m_prg_ram[0], 4, 0x400, g);
+			fclose(g);
+		}
+	}
+	fprintf(m_trace_run, "%03X", m_pc);
+	ms32_trace_state(m_trace_run);
+	fflush(m_trace_run);
+	if (m_trace_exec && m_trace_left)
+	{
+		fprintf(m_trace_exec, "S %03X", m_pc);
+		ms32_trace_state(m_trace_exec);
+	}
+}
