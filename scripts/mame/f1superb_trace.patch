+// MS32 MiSTer core: what the V70 touches, counted natively. A Lua tap on these
+// ranges runs the game at under a frame a second; this costs nothing when
+// MS32_TRACE is unset. Not for upstream.
+ms32_trace_t g_ms32_trace;
+
+void ms32_trace_t::note(int region, u32 offset)
+{
+	if (!enabled)
+		return;
+	auto &r = reg[region];
+	r.count++;
+	if (offset < r.lo) r.lo = offset;
+	if (offset > r.hi) r.hi = offset;
+	r.blocks.insert(offset >> 8);
+}
+
+void ms32_trace_t::dump()
+{
+	char const *const name[] = { "road_vram_w", "road_vram_r", "road_line_w", "road_line_r", "priram_w", "priram_r" };
+	FILE *f = fopen(path.c_str(), "w");
+	if (!f)
+		return;
+	fprintf(f, "region          accesses   lowest  highest  256-byte blocks\n");
+	for (int i = 0; i < 6; i++)
+		fprintf(f, "%-14s %9llu   %06X   %06X  %8u\n", name[i], (unsigned long long)reg[i].count,
+				reg[i].count ? reg[i].lo : 0, reg[i].count ? reg[i].hi : 0, unsigned(reg[i].blocks.size()));
+	fclose(f);
+}
